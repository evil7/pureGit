/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "puregit",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-10",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * 本地 dev 固定端口 8787：vite.config.ts 的 server.proxy（/$auth、git 端点）写死转发到
	 * 127.0.0.1:8787。⚠️ wrangler 4.118 检测到 AI agent 环境（AI_AGENT 变量）会把默认端口
	 * 偏移到 8788（并启用 Local Explorer），不固定端口会导致 proxy 502（2026-08-08 实测）。
	 */
	"dev": {
		"port": 8787
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	/**
	 * 前端静态资产（S53 修复）：指向 web 构建产物 dist/client。
	 * run_worker_first: true —— 所有请求先进 Worker（/$auth/*、git 代理优先），
	 * 其余经 env.ASSETS 服务前端 + Worker 内 SPA 回退（见 src/index.ts）。
	 * 部署前必须先 `pnpm --filter web build`。
	 */
	"assets": {
		"directory": "../web/dist/client",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	/**
	 * OAuth2 与前端配置
	 * GITHUB_CLIENT_SECRET 不在此配置（敏感），本地用 .dev.vars，生产用 wrangler secret put
	 */
	"vars": {
		"GITHUB_CLIENT_ID": "Ov23ligtlGVmtMZC2Ilc",
		"GITHUB_OAUTH_CALLBACK": "https://puregit.deepwn.io/$auth/callback",
		"SESSION_COOKIE_NAME": "puregit_session",
		"FRONTEND_URL": "https://puregit.deepwn.io",
		/**
		 * Proxy 匿名闸（2026-08-09 E12）：true/false。
		 * true（默认）= 允许匿名使用 /$wiki 与 /$raw 代理（公开内容可读）；
		 * false = 强制登录（防代理被当肉鸡刷流量，未登录 401）。
		 */
		"PROXY_ALLOW_ANON": "true"
	},
	/**
	 * KV 会话存储
	 * 生产部署: `pnpm --filter worker kv:create` 创建后填入 id（2026-08-06 已创建）
	 * 本地开发: wrangler dev 默认使用本地模拟 KV，无需真实 id
	 *
	 * ⚠️ 他人部署：下方 id 属于原作者账户，必须替换为你自己的
	 * （`pnpm --filter worker kv:create` 输出的 id）；完整模板见 wrangler.jsonc.example
	 */
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "ee0ee6ed88ba4918888fead1fd41df34"
		}
	],
	/**
	 * 自定义域名（S52/Q03）：puregit.deepwn.io 作为 Worker 主域。
	 * 前提：deepwn.io zone 已在同 Cloudflare 账户；custom_domain 会自动创建 DNS 记录与证书。
	 *
	 * ⚠️ 他人部署：不使用自定义域名时删除整个 routes 块（默认 *.workers.dev 即可）；
	 * 使用自定义域名则替换为你自己的域名。
	 */
	"routes": [
		{
			"pattern": "puregit.deepwn.io",
			"custom_domain": true
		}
	]
}