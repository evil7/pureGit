{
  "_说明": "API 对照索引人工校正表（git 跟踪）。启发式聚拢的补充/纠正：rest=@octokit/openapi 的 operationId，graphql=@octokit/graphql-schema 的 Query/Mutation 字段名。converge=curated 表示以本表为准。新增双端点 API 时在此登记，然后重跑 scripts/api-index.mjs。",
  "pairs": [
    { "rest": "repos/get", "graphql": "repository", "note": "仓库详情（smart 核心）" },
    {
      "rest": "repos/list-for-authenticated-user",
      "graphql": "viewer.repositories",
      "note": "我的仓库列表"
    },
    { "rest": "repos/list-for-user", "graphql": "user.repositories", "note": "用户仓库列表" },
    { "rest": "issues/list", "graphql": "issues", "note": "全局 issues 列表" },
    { "rest": "issues/list-for-repo", "graphql": "repository.issues", "note": "仓库 issues 列表" },
    { "rest": "issues/get", "graphql": "issue", "note": "issue 详情" },
    { "rest": "issues/create", "graphql": "createIssue", "note": "创建 issue" },
    {
      "rest": "pulls/list",
      "graphql": "repository.pullRequests",
      "note": "PR 列表（GraphQL 无顶层字段，经 repository 点路径）"
    },
    {
      "rest": "pulls/get",
      "graphql": "repository.pullRequest",
      "note": "PR 详情（GraphQL 无顶层字段，经 repository 点路径）"
    },
    { "rest": "pulls/create", "graphql": "createPullRequest", "note": "创建 PR" },
    {
      "rest": "activity/star-repo-for-authenticated-user",
      "graphql": "addStar",
      "note": "star 仓库"
    },
    {
      "rest": "activity/unstar-repo-for-authenticated-user",
      "graphql": "removeStar",
      "note": "unstar 仓库"
    },
    {
      "rest": "activity/check-repo-is-starred-by-authenticated-user",
      "graphql": "repository.viewerHasStarred",
      "note": "是否已 star"
    },
    { "rest": "repos/create-fork", "graphql": "createFork", "note": "fork 仓库" },
    { "rest": "users/get-by-username", "graphql": "user", "note": "用户主页" },
    { "rest": "users/get-authenticated", "graphql": "viewer", "note": "当前用户" },
    { "rest": "search/repos", "graphql": "search(REPOSITORY)", "note": "仓库搜索" },
    { "rest": "search/users", "graphql": "search(USER)", "note": "用户搜索" },
    {
      "rest": "search/issues-and-pull-requests",
      "graphql": "search(ISSUE)",
      "note": "issue/PR 搜索"
    },
    { "rest": "repos/get-content", "graphql": "repository.object(entry)", "note": "文件内容" },
    { "rest": "repos/get-readme", "graphql": "repository.object(blob)", "note": "README" },
    { "rest": "repos/get-commit", "graphql": "repository.object(commit)", "note": "commit 详情" },
    { "rest": "repos/list-commits", "graphql": "repository.object.history", "note": "commit 列表" },
    { "rest": "git/create-commit", "graphql": "createCommitOnBranch", "note": "文件在线编辑提交" },
    { "rest": "repos/update", "graphql": "updateRepository", "note": "仓库设置更新" },
    { "rest": "repos/delete", "graphql": "deleteRepository", "note": "删除仓库" },
    {
      "rest": "repos/create-for-authenticated-user",
      "graphql": "createRepository",
      "note": "创建仓库"
    },
    { "rest": "repos/list-releases", "graphql": "repository.releases", "note": "Releases 列表" },
    { "rest": "repos/get-release", "graphql": "repository.release", "note": "Release 详情" },
    {
      "rest": "users/list-followers-for-authenticated-user",
      "graphql": "viewer.followers",
      "note": "我的粉丝"
    },
    { "rest": "users/list-following-for-user", "graphql": "user.following", "note": "用户关注" },
    { "rest": "users/follow", "graphql": "followUser", "note": "关注用户" },
    { "rest": "users/unfollow", "graphql": "unfollowUser", "note": "取消关注" },
    { "rest": "orgs/get", "graphql": "organization", "note": "组织主页" },
    { "rest": "orgs/list-members", "graphql": "organization.membersWithRole", "note": "组织成员" },
    { "rest": "repos/list-branches", "graphql": "repository.refs", "note": "分支列表" },
    {
      "rest": "issues/list-labels-for-repo",
      "graphql": "repository.labels",
      "note": "labels 列表"
    },
    {
      "rest": "issues/list-assignees",
      "graphql": "repository.assignableUsers",
      "note": "assignees 列表"
    },
    {
      "rest": "repos/get-all-topics",
      "graphql": "repository.repositoryTopics",
      "note": "仓库 topics"
    },
    { "rest": "repos/replace-all-topics", "graphql": "updateTopics", "note": "替换 topics" },
    {
      "rest": "activity/get-repo-subscription",
      "graphql": "repository.viewerSubscription",
      "note": "订阅状态"
    },
    {
      "rest": "activity/set-repo-subscription",
      "graphql": "updateSubscription",
      "note": "设置订阅"
    },
    {
      "rest": "pulls/create-review",
      "graphql": "addPullRequestReview",
      "note": "创建评审（COMMENT/APPROVE/REQUEST_CHANGES）"
    },
    {
      "rest": "pulls/update-review",
      "graphql": "updatePullRequestReview",
      "note": "更新评审 body"
    },
    {
      "rest": "pulls/dismiss-review",
      "graphql": "dismissPullRequestReview",
      "note": "驳回已批准/已拒绝评审"
    },
    {
      "rest": "pulls/list-reviews",
      "graphql": "repository.pullRequest.reviews",
      "note": "评审列表"
    },
    {
      "rest": "pulls/create-review-comment",
      "graphql": "addPullRequestReviewComment",
      "note": "评审内评论"
    },
    {
      "rest": "pulls/create-reply-for-review-comment",
      "graphql": "addPullRequestReviewThreadReply",
      "note": "回复评审评论线程"
    },
    {
      "rest": "pulls/list-review-comments",
      "graphql": "repository.pullRequest.reviewThreads",
      "note": "评审评论线程列表"
    },
    {
      "rest": "pulls/update-review-comment",
      "graphql": "updatePullRequestReviewComment",
      "note": "更新评审评论"
    },
    { "rest": "pulls/request-reviewers", "graphql": "requestReviews", "note": "请求评审者" },
    {
      "rest": "pulls/merge",
      "graphql": "mergePullRequest",
      "note": "合并 PR（merge/rebase/squash）"
    },
    { "rest": "pulls/update", "graphql": "updatePullRequest", "note": "更新 PR 标题/body/状态" },
    { "rest": "pulls/update-branch", "graphql": "updatePullRequestBranch", "note": "更新 PR 分支" }
  ]
}
