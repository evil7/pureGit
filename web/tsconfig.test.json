{
  "compilerOptions": {
    "jsx": "react-jsx",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "incremental": true,
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    /* 注：jest-dom 的 vitest matchers 类型由 test/setup.ts 的
       import "@testing-library/jest-dom/vitest" 显式提供（扩展 vitest Assertion<T>）；
       此处 types 数组**不要**列 @testing-library/jest-dom——主入口是 jest 版
       （namespace jest），对 vitest 的 Assertion<T> 无效且干扰 IDE 类型解析 */
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["test", "vitest.config.mts", "src/types"]
}
